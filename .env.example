PORT=3000
NODE_ENV=development

# Postgres connection string del proyecto Supabase (Settings -> Database).
DATABASE_URL=

# Settings -> API del proyecto Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional — si se omite se deriva de SUPABASE_URL (.../auth/v1/.well-known/jwks.json).
SUPABASE_JWKS_URL=

# Opcional — si no se setea, el cache cae a memoria en vez de Redis.
REDIS_URL=

# Orígenes permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=http://localhost:3000
